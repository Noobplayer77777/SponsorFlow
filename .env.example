# SponsorFlow Environment Variables

# DATABASE
# Required for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/sponsorflow?schema=public"

# GOOGLE OAUTH
# Needed for Google Login (Backend and Frontend)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# GMAIL API
# Needed later for sending emails via Gmail
GMAIL_CLIENT_ID="your-gmail-client-id"
GMAIL_CLIENT_SECRET="your-gmail-client-secret"
GMAIL_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# AUTHENTICATION
# Required for JWT signing
JWT_SECRET="your-super-secret-jwt-key"

# URLS
# Base URLs for frontend and backend
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# FUTURE: REDIS & STORAGE
# Needed later for background jobs (BullMQ) and file uploads
REDIS_URL="redis://localhost:6379"
STORAGE_URL="your-storage-bucket-url"
